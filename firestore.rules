rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every PayProof read and write goes through the backend's Firebase Admin
    // SDK, which is not subject to these rules. No client — the frontend, a
    // mobile app, or anyone else who grabs the public Firebase web config and
    // writes their own script — may read or write anything directly. This
    // also means a signed-in user cannot tamper with their own usage
    // counters (users/{uid}/usage/{day}) or touch the shared
    // sample-extraction cache: nothing is reachable from a client, period.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
