rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user may read and write only documents under their own uid
    // (REQUIREMENTS.md section 4.2 and 11). The backend verifies the
    // Firebase ID token separately; these rules are the second line of
    // defence for any direct client access.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
