# PayProof environment variables.
# Copy this file to .env and fill in only what is empty. NEVER commit .env.
# In PowerShell:  Copy-Item .env.example .env

# --- Project ---
PROJECT_ID=payproof-nithin-2026
REGION=asia-south1
# asia-south1 is NOT a supported Vertex AI region for gemini-3.1/3.5/3.8 flash and flash-lite
# models (checked Oct 2026: they are only on the global, us and eu endpoints). Cloud Run itself
# still runs in asia-south1; only the Vertex AI model endpoint location differs.
VERTEX_LOCATION=global

# --- Gemini ---
# aistudio = Gemini API key, LOCAL tests with SIMULATED images only (the free tier may use content to improve Google products)
# vertex   = Vertex AI with application default credentials; use this for the deployed app
GEMINI_BACKEND=aistudio
# AI Studio key. Local only. Leave empty on Cloud Run.
GEMINI_API_KEY=
# EXTRACTION_MODEL chosen in Phase 2 step B after a 20-image, 3-model comparison on the
# AI Studio free tier (gemini-3.1-flash-lite vs gemini-3.5-flash-lite vs gemini-3.8-flash):
# see PROGRESS.md and eval/model_selection_results.json. gemini-3.1-flash-lite and
# gemini-3.5-flash-lite both reached ~100% field accuracy and 100% order-offer rejection;
# gemini-3.1-flash-lite was chosen as the cheaper of the two (owner's choice, 7 Oct 2026).
# gemini-3.8-flash could not be evaluated: all 20 calls failed (timeout/server error) on
# the free tier that day.
# EXPLAIN_MODEL is not yet chosen (decided in Phase 4 for the Q&A path).
EXTRACTION_MODEL=gemini-3.1-flash-lite
EXPLAIN_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# --- Image preparation and limits (cost control) ---
IMAGE_MAX_SIDE_PX=1280
IMAGE_JPEG_QUALITY=85
MAX_UPLOAD_MB=8
EXTRACTION_MAX_OUTPUT_TOKENS=1500
ANSWER_MAX_OUTPUT_TOKENS=400

# --- Usage limits (cost control) ---
LIMIT_EXTRACTIONS_PER_USER_PER_DAY=12
LIMIT_QUESTIONS_PER_USER_PER_DAY=25
LIMIT_GLOBAL_GEMINI_CALLS_PER_DAY=400

# Notes:
# - The Firebase web config (apiKey, authDomain, projectId, appId) is not secret; it goes in frontend/firebase-config.js, not here.
# - On Cloud Run, Vertex AI uses the service account. Do not create or commit key files.
